# ===================================================================
#  Configuración de resinovo.com (Apache / cPanel)
# ===================================================================

# ---------- 0. REDIRECCIÓN WWW -> NON-WWW (unifica el dominio) ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Redirige www.resinovo.com -> resinovo.com (301 permanente)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>


# ---------- 1. COMPRESIÓN GZIP ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE application/font-woff application/font-woff2
</IfModule>

# ---------- 2. CABECERAS CACHE-CONTROL (único control de caché) ----------
<IfModule mod_headers.c>
  <!-- Imágenes y fuentes: caché larga, no cambian de nombre -->
  <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|ico|woff|woff2)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
  <!-- CSS y JS: sin caché. Al subir el archivo, todos ven la versión nueva al instante -->
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <!-- HTML: nunca cachear, para que los cambios se vean al instante -->
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
